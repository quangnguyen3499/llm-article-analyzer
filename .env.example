SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=1

# Database
DB_NAME=article_analyzer
DB_USER=admin
DB_PASSWORD=change-this-local-password
DB_HOST=db
DB_PORT=5432
DB_CONNECTION_STRING=postgresql://admin:change-this-local-password@db:5432/article_analyzer

# Local Ollama
LLM_BACKEND=OLLAMA
EMBEDDING_BACKEND=OLLAMA
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
# The default Ollama chat setup does not expose embeddings.
RAG_ENABLED=0

# Optional OpenAI fallback
OPENAI_API_KEY=

# Startup and tracing
RUN_MIGRATIONS=1
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
